{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Style Bible",
  "type": "object",
  "required": [
    "name",
    "version",
    "visual_thesis",
    "invariants",
    "variation_axes",
    "palette",
    "materials",
    "composition",
    "subject_treatment",
    "camera_language",
    "motion_grammar",
    "negative_constraints",
    "generator_adapters",
    "fallbacks"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "visual_thesis": {
      "type": "string",
      "minLength": 20
    },
    "invariants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {"type": "string", "minLength": 8}
    },
    "variation_axes": {
      "type": "object",
      "minProperties": 1
    },
    "palette": {
      "type": "object",
      "required": ["paper", "neutral", "accent", "forbidden"]
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "composition": {
      "type": "object",
      "minProperties": 1
    },
    "subject_treatment": {
      "type": "object",
      "minProperties": 1
    },
    "camera_language": {
      "type": "object",
      "minProperties": 1
    },
    "motion_grammar": {
      "type": "object",
      "required": ["formation", "subject", "transition", "settle"]
    },
    "negative_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "generator_adapters": {
      "type": "object"
    },
    "fallbacks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
